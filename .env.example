ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://crawlforge:crawlforge@postgres:5432/crawlforge
REDIS_URL=redis://redis:6379/0
API_KEY_PEPPER=replace-with-a-long-random-secret
USER_AGENT=CrawlForge/0.1 (+https://github.com/your-org/crawlforge)
DEFAULT_RATE_LIMIT_RPM=60
DEFAULT_MONTHLY_QUOTA=10000
SCRAPE_TIMEOUT_SECONDS=30
MAX_RESPONSE_BYTES=10485760
MAX_STORED_HTML_BYTES=2097152
MAX_STORED_MARKDOWN_BYTES=1048576
RETENTION_BODY_DAYS=7
RETENTION_RECORD_DAYS=30
BROWSER_POOL_SIZE=4
HTTP_PROXY_URLS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1
OTEL_EXPORTER_OTLP_ENDPOINT=
